# Base local del backend. Sustituye los valores de ejemplo en tu archivo .env.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tienda_virtual
FRONTEND_URL=http://localhost:5173
# En producción debe ser la URL HTTPS permanente del backend; no uses trycloudflare.com.
BACKEND_URL=http://localhost:5000

# Usa valores aleatorios de al menos 32 caracteres; nunca confirmes el .env real.
JWT_SECRET=
# Sesiones administrativas: acceso corto + renovación rotativa revocable.
ADMIN_ACCESS_TOKEN_MINUTES=15
ADMIN_SESSION_IDLE_HOURS=12
ADMIN_SESSION_ABSOLUTE_HOURS=168
# En local usa lax. En frontend/backend de dominios distintos usa none con HTTPS.
ADMIN_COOKIE_SAME_SITE=lax
# Clave estable y exclusiva para la cadena HMAC de auditoría de Clientes.
# No debe cambiarse sin un procedimiento formal de rotación y conservación.
CUSTOMER_AUDIT_HASH_SECRET=
# Conservación mínima previa a anonimización (10 años por defecto).
CUSTOMER_RETENTION_DAYS=3650
ORDER_RETURN_ACCESS_SECRET=
CART_ACCESS_SECRET=
# Diferencia máxima (COP) que un cajero puede cerrar sin aprobación de supervisor.
CASH_VARIANCE_TOLERANCE=1000
# Firma el acceso público a resultados de pago; debe ser distinta de JWT_SECRET en producción.
ORDER_PAYMENT_ACCESS_SECRET=
BILLING_ENCRYPTION_KEY=
INTEGRATIONS_ENCRYPTION_KEY=
# Clave estable y exclusiva para cifrar secretos TOTP. Si queda vacía se usa
# INTEGRATIONS_ENCRYPTION_KEY como respaldo. No la cambies con 2FA activo.
ADMIN_2FA_ENCRYPTION_KEY=
ADMIN_2FA_ISSUER=Tienda Virtual
# Roles que deben activar 2FA antes de usar el panel. Usa none solo en una
# recuperación controlada; owner y admin son obligatorios por defecto.
ADMIN_2FA_REQUIRED_ROLES=owner,admin
# Cifra las credenciales SMTP guardadas desde Configuración > Correo.
MAIL_ENCRYPTION_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=tienda_virtual

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# La operación manual sigue siendo la opción segura por defecto.
SHIPPING_PROVIDER=manual

# Envia.com permanece en Sandbox hasta disponer de una cuenta y token de prueba.
ENVIA_MODE=sandbox
ENVIA_TOKEN=
ENVIA_SANDBOX_WEBHOOK_TOKEN=
ENVIA_WEBHOOK_SECRET=
ENVIA_TIMEOUT_MS=15000
