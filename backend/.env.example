# Base local del backend. Sustituye los valores de ejemplo en tu archivo .env.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tienda_virtual
FRONTEND_URL=http://localhost:5173
# En producción debe ser la URL HTTPS permanente del backend; no uses trycloudflare.com.
BACKEND_URL=http://localhost:5000

# Usa valores aleatorios de al menos 32 caracteres; nunca confirmes el .env real.
JWT_SECRET=
CART_ACCESS_SECRET=
BILLING_ENCRYPTION_KEY=
INTEGRATIONS_ENCRYPTION_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=tienda_virtual

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# La operación manual sigue siendo la opción segura por defecto.
SHIPPING_PROVIDER=manual

# Envia.com permanece en Sandbox hasta disponer de una cuenta y token de prueba.
ENVIA_MODE=sandbox
ENVIA_TOKEN=
ENVIA_SANDBOX_WEBHOOK_TOKEN=
ENVIA_WEBHOOK_SECRET=
ENVIA_TIMEOUT_MS=15000
